                'TGL_CUTI_SAMPAI'  => !empty($data['TGL_CUTI_SAMPAI']) ? $data['TGL_CUTI_SAMPAI'] : null,
                'HARI'             => !empty($data['HARI']) ? (int)$data['HARI'] : 1,
                'KETERANGAN'       => $data['KETERANGAN'] ?? null
            ];

            if (empty($kd)) {
                $maxRow = $this->db->query("SELECT COALESCE(MAX(KD_CUTI), 0) + 1 AS next_id FROM detail_cuti_pegawai")->getRowArray();
                $record['KD_CUTI'] = $maxRow['next_id'];
                $this->db->table('detail_cuti_pegawai')->insert($record);
