app.logo_bpjs = 'http://127.0.0.1/evoHRIS_v2.1/api/assets/logo_bpjs.jpg'
app.logo_kab = 'http://127.0.0.1/evoHRIS_v2.1/api/assets/logo_kab_taliabu.png'
app.inapApiUrl = 'http://127.0.0.1/evoHRIS_v2.1/api_inap'
app.inapEvoUrl = 'http://127.0.0.1/bobong/evoMedis'
app.images = 'http://127.0.0.1/evoHRIS_v2.1/assets/img'
app.verifikasi.blocker = false
app.verifikasi.notif = false
app.url_ttd = 'http://esignature.rsudkarawang.com/esignature'
app.verifikasiMobilePhotoURL = 'http://127.0.0.1/evoHRIS_v2.1/api/writable/uploads/verifikasi_mobile'
