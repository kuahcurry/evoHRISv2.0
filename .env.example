#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#-------------------------------------------------------------------- 
app.zona = 7
app.range = 24 #in hour
app.rangeIGD = 48 #in hour
app.rangeKonsul = 24 #in hour
app.rangeRekam = 72 #in hour
app.tipe_resep_signa = 'A' #A = signa pisah, B = signa bebas, C = signa master
app.tipe_resep_obat = 'A' #A = stok obat per depo, B = stok obat all depo, C = KHUSUS YPK
app.tipe_ppra = 'B' #A = tidak ada unit ppra, B = ada unit ppra
app.tipe_catatan_resep = 'A' #A = tidak pakai catatan resep, B = pakai catatan resep
app.tipe_depo = 'A' #A = tidak pakai selector depo, B = pakai selector depo
app.tipe_satuan_racik = 'A' #A = tidak pakai satuan racik, B = pakai satuan racik
app.tipe_konsul_mpp = 'B' #A = tidak pakai konsul mpp, B = pakai konsul mpp
app.tipe_prb = 'B' #A = tidak pakai prb, B = pakai prb
app.root = 'C:\xampp\htdocs\evoHRIS_v2.1'
app.dokumen = '/var/www/dokumen_rm'
app.dokumenURL = 'http://127.0.0.1/bobong/dokumen_rm'
app.baseURL = 'http://127.0.0.1/evoHRIS_v2.1/api'
app.evomedisURL = 'http://127.0.0.1/bobong/evoMedis/images/ttd'
app.services = 'http://127.0.0.1:9200'
app.nama_daerah = ''
app.nama_rs_pemerintah = 'PEMERINTAH KABUPATEN PULAU TALIABU'
app.nama_rs = 'UOBK RUMAH SAKIT UMUM DAERAH'
app.kota_rs = 'PULAU TALIABU'
app.alamat_rs = 'Jl. Lintas Selatan, Desa Ratahaya, Kecamatan Taliabu Barat , Kabupaten Pulau Taliabu, Provinsi Maluku Utara'
app.telp_rs = '085211917591'
app.email_rs = 'rsud.pulautaliabu@gmail.com'
app.kodepos_rs = ''
app.fax_rs = ''
app.logo_rs = 'http://127.0.0.1/evoHRIS_v2.1/api/assets/logo_bobong.png'
